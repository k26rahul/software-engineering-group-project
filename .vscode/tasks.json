{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend Format Check",
      "type": "shell",
      "command": "uv run ruff format --check .",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend Lint Check",
      "type": "shell",
      "command": "uv run ruff check .",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Backend Test",
      "type": "shell",
      "command": "uv run pytest",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Validate Backend",
      "dependsOn": [
        "Backend Format Check",
        "Backend Lint Check",
        "Backend Test"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    },
    {
      "label": "Validate Frontend",
      "type": "shell",
      "command": "npm run validate",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
